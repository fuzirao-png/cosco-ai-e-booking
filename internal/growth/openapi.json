  "components": {
    "schemas": {
      "Interrupt": {
        "properties": {
          "asr_partial_token": {
            "type": "string",
            "maxLength": 1200,
            "title": "Asr Partial Token",
            "default": ""
          }
        },
        "type": "object",
        "title": "Interrupt"
      },
      "OpenCall": {
        "properties": {
          "lead_id": {
            "type": "string",
            "title": "Lead Id"
          }
        },
        "type": "object",
        "required": [
          "lead_id"
        ],
        "title": "OpenCall"
      },
      "TurnInput": {
        "properties": {
          "asr_text": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Asr Text"
          }
        },
        "type": "object",
        "required": [
          "asr_text"
        ],
        "title": "TurnInput"
      },
      "Error": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
