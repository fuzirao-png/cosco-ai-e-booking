    "/api/calls/{session_id}/turns": {
      "post": {
        "summary": "Turn",
        "operationId": "turn_api_calls__session_id__turns_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
