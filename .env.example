GROWTH_DB_PATH=runtime/growth.sqlite3
# GROWTH_ADDR=127.0.0.1:8000
# GROWTH_STATIC_DIR=frontend/dist

# Optional OpenAI-compatible Chat Completions endpoint.
# GROWTH_MODEL_BASE_URL=https://api.openai.com/v1
# GROWTH_MODEL_API_KEY=
# GROWTH_MODEL=
# GROWTH_JUDGE_MODEL=

# Default: deterministic, local character n-gram vectors.
GROWTH_EMBEDDINGS=local

# For bge mode use an OpenAI-compatible Embeddings endpoint serving a BGE model.
# GROWTH_EMBEDDINGS=bge
# GROWTH_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# GROWTH_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# GROWTH_EMBEDDING_API_KEY=
